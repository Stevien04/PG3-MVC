<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>ControlCategoria</servlet-name>
        <servlet-class>Controlador.ControlCategoria</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControlMarca</servlet-name>
        <servlet-class>Controlador.ControlMarca</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControlCliente</servlet-name>
        <servlet-class>Controlador.ControlCliente</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControlEmpleado</servlet-name>
        <servlet-class>Controlador.ControlEmpleado</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControlLogin</servlet-name>
        <servlet-class>Controlador.ControlLogin</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControlProducto</servlet-name>
        <servlet-class>Controlador.ControlProducto</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ControlCategoria</servlet-name>
        <url-pattern>/ControlCategoria</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControlMarca</servlet-name>
        <url-pattern>/ControlMarca</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControlCliente</servlet-name>
        <url-pattern>/ControlCliente</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControlEmpleado</servlet-name>
        <url-pattern>/ControlEmpleado</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControlLogin</servlet-name>
        <url-pattern>/ControlLogin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControlProducto</servlet-name>
        <url-pattern>/ControlProducto</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
